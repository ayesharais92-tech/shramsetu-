# Application Environment
VITE_APP_NAME="SHRAMSETU — Cooperative Gig Services Platform"
VITE_ENVIRONMENT=development
VITE_DEMO_MODE=true

# Database (PostgreSQL / Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shramsetu?schema=public"

# Authentication & Session Security
JWT_SECRET="shramsetu_ncct_jwt_secret_token_change_in_production"
JWT_EXPIRY="7d"

# Caching & Event Bus (Redis)
REDIS_URL="redis://localhost:6379"

# AI / ML Demand Forecasting Service (FastAPI / PyTorch)
AI_SERVICE_URL="http://localhost:8000"

# Digital Payments Gateway (Integration Ready)
PAYMENT_GATEWAY_KEY="rzp_test_placeholder_key_sih2026"
PAYMENT_GATEWAY_SECRET="rzp_secret_placeholder_key_sih2026"

# OpenStreetMap / Leaflet Tile Server
VITE_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
MAP_API_KEY="osm_free_tier_placeholder"

# SMS / Notification Provider (Demo / Integration Ready)
SMS_GATEWAY_API_KEY="fast2sms_demo_key_placeholder"
GOV_DIGILOCKER_CLIENT_ID="digilocker_sandbox_client_id"
